----------------------------------------------------------------------------------------
-- Head and Neck features
-- This query is used to extract the features from the Head and Neck dataset.

-- VERSION  | AUTHOR         | DATE          | DESCRIPTION
-- -------------------------------------------------------------------------------------
-- 1.0      | F. Martin      | 2026-02-10    | Initial version
-- -------------------------------------------------------------------------------------
-- 1.1      | F. Martin      | 2026-02-11    | Update the clinical staging codes and 
--          | A. van Gestel  |               | fixed some minor issues.
-- -------------------------------------------------------------------------------------
-- 1.2      | F. Martin      | 2026-03-10    | Introduced flexible feature selection,
--          |                |               | using Jinja2 template.
-- -------------------------------------------------------------------------------------
-- 1.3      | F. Martin      | 2026-04-22    | Selected only patients that are in the
--          |                |               | cohort.
--
----------------------------------------------------------------------------------------

{# Valid OMOP calendars for cohort export; outliers break R/Python date conversion #}
{% set COHORT_DATE_MIN = "DATE '1900-01-01'" %}
{% set COHORT_DATE_MAX = "DATE '2030-01-01'" %}
{% macro cohort_safe_date(expr) -%}
(CASE
    WHEN ({{ expr }}) IS NULL THEN NULL
    WHEN ({{ expr }}) < {{ COHORT_DATE_MIN }} OR ({{ expr }}) >= {{ COHORT_DATE_MAX }} THEN NULL
    ELSE ({{ expr }})::date
END)
{%- endmacro %}

WITH

    -- Define the list of patient IDs to analyze
    patient_id_list AS (
        SELECT DISTINCT 
            t.person_id as person_id
        FROM 
            (VALUES {{ patient_ids }}) AS t(person_id)
        JOIN 
            {{ cdm_schema }}.person person
            ON t.person_id = person.person_id
    ),

    -- PERSON table
    person AS (
        SELECT
            pid.person_id, -- e.g. 12345
            gender_concept.concept_name as sex, -- e.g. "Female" or "Male"
            person.year_of_birth -- e.g. 1990
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.person person 
            ON pid.person_id = person.person_id
        LEFT JOIN
            {{ cdm_schema }}.concept gender_concept 
            ON person.gender_concept_id = gender_concept.concept_id
    ),

    -- EPISODE table
    primary_tumor AS (
        SELECT
            pid.person_id,
            episode.episode_id                                                      AS episode_id,
            {{ cohort_safe_date('episode.episode_start_date') }}                    AS diagnosis_date, -- e.g. 2020-01-01
            CASE
                WHEN episode.episode_start_date IS NULL THEN NULL
                WHEN episode.episode_start_date < {{ COHORT_DATE_MIN }}
                    OR episode.episode_start_date >= {{ COHORT_DATE_MAX }} THEN NULL
                ELSE EXTRACT(YEAR FROM episode.episode_start_date) - person.year_of_birth
            END                                                                     AS age_at_diagnosis, -- e.g. 67
            diagnosis_concept.concept_name                                          AS diagnosis_code, -- e.g. "C34.1-8888/8"
            NULLIF(split_part(diagnosis_concept.concept_code, '-', 1), '')          AS morphology, -- e.g. 8888/8
            NULLIF(split_part(diagnosis_concept.concept_code, '-', 2), '')          AS topography -- e.g. C34.1
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            {{ cdm_schema }}.concept diagnosis_concept
            ON episode.episode_object_concept_id = diagnosis_concept.concept_id
        LEFT JOIN
            {{ cdm_schema }}.person person
            ON pid.person_id = person.person_id
        WHERE
            episode.episode_concept_id = 32533 -- Disease Episode
    ),

    -- Surgeries table
    -- - only surgeries on/after diagnosis_date
    -- - ordered by date per patient
    -- surgery_id numbers surgeries per patient (1–5)
    -- surgery_id = 1 corresponds to primary surgery

    surgeries AS (
        SELECT *
        FROM (
            SELECT
                pid.person_id,
                episode.episode_id,
                {{ cohort_safe_date('episode.episode_start_date') }} AS date_of_surgery,
                ROW_NUMBER() OVER (
                    PARTITION BY pid.person_id
                    ORDER BY episode.episode_start_date ASC
                ) AS surgery_id
            FROM
                patient_id_list pid
            LEFT JOIN {{ cdm_schema }}.episode episode
                ON pid.person_id = episode.person_id
            LEFT JOIN primary_tumor
                ON pid.person_id = primary_tumor.person_id
            WHERE
                episode.episode_concept_id = 32939 -- Surgery Episode
                AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
                AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
                AND episode.episode_start_date >= primary_tumor.diagnosis_date
        ) s
        WHERE surgery_id <= 10
    ),


    -- Assumption: first surgery intent is the relevant one
    surgery_intent AS (
        SELECT
            episode_id,
            surgery_intent
        FROM (
            SELECT
                ee.episode_id,
                m.measurement_concept_id,
                c.concept_name AS surgery_intent,                
                ROW_NUMBER() OVER (
                    PARTITION BY ee.episode_id
                    ORDER BY m.measurement_date ASC
                ) AS rn
            FROM {{ cdm_schema }}.episode episode
            JOIN {{ cdm_schema }}.episode_event ee
                ON episode.episode_id = ee.episode_id
            JOIN {{ cdm_schema }}.procedure_occurrence po
                ON ee.event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.measurement m
                ON m.measurement_event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.concept c
                ON c.concept_id = m.measurement_concept_id
            WHERE
                episode.episode_concept_id = 32939 -- Surgery episode
                AND m.measurement_concept_id IN (4179711, 4162591)
                AND m.measurement_date >= {{ COHORT_DATE_MIN }}
                AND m.measurement_date < {{ COHORT_DATE_MAX }}
        ) si
        WHERE rn = 1
    ),

    -- Assumption: first margins after surgery is the relevant one
    margins_after_surgery AS (
        SELECT
            episode_id,
            margins_after_surgery
        FROM (
            SELECT
                ee.episode_id,
                m.measurement_concept_id,
                c.concept_name AS margins_after_surgery,
                ROW_NUMBER() OVER (
                    PARTITION BY ee.episode_id
                    ORDER BY m.measurement_date ASC
                ) AS rn
            FROM {{ cdm_schema }}.episode episode
            JOIN {{ cdm_schema }}.episode_event ee
                ON episode.episode_id = ee.episode_id
            JOIN {{ cdm_schema }}.procedure_occurrence po
                ON ee.event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.measurement m
                ON m.measurement_event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.concept c
                ON c.concept_id = m.measurement_concept_id
            WHERE
                episode.episode_concept_id = 32939 -- Surgery episode
                AND m.measurement_concept_id IN (1634643, 1633801, 1634484)
                AND m.measurement_date >= {{ COHORT_DATE_MIN }}
                AND m.measurement_date < {{ COHORT_DATE_MAX }}
        ) mas
        WHERE rn = 1
    ),

{% if is_head_and_neck %}
   -- Assumption: first surgery_extra_nodal_extension is the relevant one
    surgery_extra_nodal_extension AS (
        SELECT
            episode_id,
            surgery_extra_nodal_extension
        FROM (
            SELECT
                ee.episode_id,
                m.measurement_concept_id,
                c.concept_name AS surgery_extra_nodal_extension,
                ROW_NUMBER() OVER (
                    PARTITION BY ee.episode_id
                    ORDER BY m.measurement_date ASC
                ) AS rn
            FROM {{ cdm_schema }}.episode episode
            JOIN {{ cdm_schema }}.episode_event ee
                ON episode.episode_id = ee.episode_id
            JOIN {{ cdm_schema }}.procedure_occurrence po
                ON ee.event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.measurement m
                ON m.measurement_event_id = po.procedure_occurrence_id
                AND m.measurement_concept_id IN (36769946, 36770618)
            JOIN {{ cdm_schema }}.concept c
                ON c.concept_id = m.measurement_concept_id
            WHERE
                episode.episode_concept_id = 32939 -- Surgery episode
        ) si
        WHERE rn = 1
    ),

    surgery_laterality_of_the_dissection AS (
        SELECT
            episode_id,
            laterality_of_the_dissection
        FROM (
            SELECT
                episode.episode_id,
                m.measurement_concept_id,
                c.concept_name AS laterality_of_the_dissection,
                ROW_NUMBER() OVER (
                    PARTITION BY ee.episode_id
                    ORDER BY m.measurement_date ASC
                ) AS rn
            FROM {{ cdm_schema }}.episode episode
            JOIN {{ cdm_schema }}.episode_event ee
                ON episode.episode_id = ee.episode_id
            JOIN {{ cdm_schema }}.procedure_occurrence po
                ON ee.event_id = po.procedure_occurrence_id
            JOIN {{ cdm_schema }}.measurement m
                ON m.measurement_event_id = po.procedure_occurrence_id
                AND m.measurement_concept_id IN (4112106, 4117496, 4112107)
            JOIN {{ cdm_schema }}.concept c
                ON c.concept_id = m.measurement_concept_id
            WHERE episode.episode_concept_id = 32939 -- Surgery episode
        ) la
        WHERE rn = 1
    ),

    table_neck_surgery AS (
        SELECT
            episode_id,
            1 AS neck_surgery,
            {{ cohort_safe_date('procedure_date') }} AS date_of_neck_surgery
        FROM (
            SELECT
                e.episode_id,
                po.procedure_date,
                ROW_NUMBER() OVER (
                    PARTITION BY e.episode_id
                    ORDER BY po.procedure_date
                ) AS rn
            FROM {{ cdm_schema }}.episode e
            JOIN {{ cdm_schema }}.episode_event ee
                ON e.episode_id = ee.episode_id
            JOIN {{ cdm_schema }}.procedure_occurrence po
                ON ee.event_id = po.procedure_occurrence_id
            WHERE 
                e.episode_concept_id = 32939
                AND po.procedure_concept_id = 4291481
        ) ns
        WHERE rn = 1
    ),

    surgery_hospital AS (
        SELECT
            episode.episode_id,
            provider.provider_name AS surgery_hospital
        FROM {{ cdm_schema }}.episode episode
        JOIN {{ cdm_schema }}.episode_event ee
            ON episode.episode_id = ee.episode_id
        JOIN {{ cdm_schema }}.procedure_occurrence po
            ON ee.event_id = po.procedure_occurrence_id
        JOIN {{ cdm_schema }}.provider provider
            ON po.provider_id = provider.provider_id
        WHERE episode.episode_concept_id = 32939 -- Surgery episode
    ),
    
{% endif %}

    surgeries_enriched AS (
        SELECT
            surgeries.person_id,
            surgeries.episode_id,
            surgeries.date_of_surgery,
            surgeries.surgery_id,
            surgery_intent.surgery_intent,
            margins_after_surgery.margins_after_surgery
            {% if is_head_and_neck %},
            surgery_extra_nodal_extension.surgery_extra_nodal_extension,
            surgery_laterality_of_the_dissection.laterality_of_the_dissection,
            COALESCE(table_neck_surgery.neck_surgery, 0) AS neck_surgery,
            table_neck_surgery.date_of_neck_surgery,
            surgery_hospital.surgery_hospital
            {% endif %}
        FROM surgeries surgeries
        LEFT JOIN surgery_intent surgery_intent
            ON surgeries.episode_id = surgery_intent.episode_id
        LEFT JOIN margins_after_surgery margins_after_surgery
            ON surgeries.episode_id = margins_after_surgery.episode_id
        {% if is_head_and_neck %}
        LEFT JOIN surgery_extra_nodal_extension surgery_extra_nodal_extension
            ON surgeries.episode_id = surgery_extra_nodal_extension.episode_id
        LEFT JOIN surgery_laterality_of_the_dissection surgery_laterality_of_the_dissection
            ON surgeries.episode_id = surgery_laterality_of_the_dissection.episode_id
        LEFT JOIN table_neck_surgery table_neck_surgery
            ON surgeries.episode_id = table_neck_surgery.episode_id
        LEFT JOIN surgery_hospital surgery_hospital
            ON surgeries.episode_id = surgery_hospital.episode_id
        {% endif %}
    ),

    surgeries_wide AS (
    SELECT
        person_id,

        -- Surgery 1
        MAX(CASE WHEN surgery_id = 1 THEN date_of_surgery END)                  AS surgery_1_date,
        MAX(CASE WHEN surgery_id = 1 THEN surgery_intent END)                   AS surgery_1_intent,
        MAX(CASE WHEN surgery_id = 1 THEN margins_after_surgery END)            AS surgery_1_margins_after_surgery,

            {% if is_head_and_neck %}
        MAX(CASE WHEN surgery_id = 1 THEN surgery_extra_nodal_extension END)    AS surgery_1_extra_nodal_extension,
        MAX(CASE WHEN surgery_id = 1 THEN laterality_of_the_dissection END)     AS surgery_1_laterality_of_the_dissection,
        MAX(CASE WHEN surgery_id = 1 THEN neck_surgery END)                     AS surgery_1_neck_surgery,
        MAX(CASE WHEN surgery_id = 1 THEN date_of_neck_surgery END)             AS surgery_1_date_of_neck_surgery,
        MAX(CASE WHEN surgery_id = 1 THEN surgery_hospital END)                 AS surgery_1_surgery_hospital,
            {% endif %}

        -- Surgery 2
        MAX(CASE WHEN surgery_id = 2 THEN date_of_surgery END)                  AS surgery_2_date,
        MAX(CASE WHEN surgery_id = 2 THEN surgery_intent END)                   AS surgery_2_intent,
        MAX(CASE WHEN surgery_id = 2 THEN margins_after_surgery END)            AS surgery_2_margins_after_surgery,
            
            {% if is_head_and_neck %}
        MAX(CASE WHEN surgery_id = 2 THEN surgery_extra_nodal_extension END)    AS surgery_2_extra_nodal_extension,
        MAX(CASE WHEN surgery_id = 2 THEN laterality_of_the_dissection END)     AS surgery_2_laterality_of_the_dissection,
        MAX(CASE WHEN surgery_id = 2 THEN neck_surgery END)                     AS surgery_2_neck_surgery,
        MAX(CASE WHEN surgery_id = 2 THEN date_of_neck_surgery END)             AS surgery_2_date_of_neck_surgery,
        MAX(CASE WHEN surgery_id = 2 THEN surgery_hospital END)                 AS surgery_2_surgery_hospital,
            {% endif %}

        -- Surgery 3
        MAX(CASE WHEN surgery_id = 3 THEN date_of_surgery END)                  AS surgery_3_date,
        MAX(CASE WHEN surgery_id = 3 THEN surgery_intent END)                   AS surgery_3_intent,
        MAX(CASE WHEN surgery_id = 3 THEN margins_after_surgery END)            AS surgery_3_margins_after_surgery,

            {% if is_head_and_neck %}
        MAX(CASE WHEN surgery_id = 3 THEN surgery_extra_nodal_extension END)    AS surgery_3_extra_nodal_extension,
        MAX(CASE WHEN surgery_id = 3 THEN laterality_of_the_dissection END)     AS surgery_3_laterality_of_the_dissection,
        MAX(CASE WHEN surgery_id = 3 THEN neck_surgery END)                     AS surgery_3_neck_surgery,
        MAX(CASE WHEN surgery_id = 3 THEN date_of_neck_surgery END)             AS surgery_3_date_of_neck_surgery,
        MAX(CASE WHEN surgery_id = 3 THEN surgery_hospital END)                 AS surgery_3_surgery_hospital,
            {% endif %}

        -- Surgery 4
        MAX(CASE WHEN surgery_id = 4 THEN date_of_surgery END)                  AS surgery_4_date,
        MAX(CASE WHEN surgery_id = 4 THEN surgery_intent END)                   AS surgery_4_intent,
        MAX(CASE WHEN surgery_id = 4 THEN margins_after_surgery END)            AS surgery_4_margins_after_surgery,
            {% if is_head_and_neck %}
        MAX(CASE WHEN surgery_id = 4 THEN surgery_extra_nodal_extension END)    AS surgery_4_extra_nodal_extension,
        MAX(CASE WHEN surgery_id = 4 THEN laterality_of_the_dissection END)     AS surgery_4_laterality_of_the_dissection,
        MAX(CASE WHEN surgery_id = 4 THEN neck_surgery END)                     AS surgery_4_neck_surgery,
        MAX(CASE WHEN surgery_id = 4 THEN date_of_neck_surgery END)             AS surgery_4_date_of_neck_surgery,
        MAX(CASE WHEN surgery_id = 4 THEN surgery_hospital END)                 AS surgery_4_surgery_hospital,
            {% endif %}

        -- Surgery 5
        MAX(CASE WHEN surgery_id = 5 THEN date_of_surgery END)                  AS surgery_5_date,
        MAX(CASE WHEN surgery_id = 5 THEN surgery_intent END)                   AS surgery_5_intent,
        MAX(CASE WHEN surgery_id = 5 THEN margins_after_surgery END)            AS surgery_5_margins_after_surgery,
            {% if is_head_and_neck %}
        MAX(CASE WHEN surgery_id = 5 THEN surgery_extra_nodal_extension END)    AS surgery_5_extra_nodal_extension,
        MAX(CASE WHEN surgery_id = 5 THEN laterality_of_the_dissection END)     AS surgery_5_laterality_of_the_dissection,
        MAX(CASE WHEN surgery_id = 5 THEN neck_surgery END)                     AS surgery_5_neck_surgery,
        MAX(CASE WHEN surgery_id = 5 THEN date_of_neck_surgery END)             AS surgery_5_date_of_neck_surgery,
        MAX(CASE WHEN surgery_id = 5 THEN surgery_hospital END)                 AS surgery_5_surgery_hospital,
            {% endif %}

        -- Surgery 6-10
        MAX(CASE WHEN surgery_id = 6 THEN date_of_surgery END)                  AS surgery_6_date,
        MAX(CASE WHEN surgery_id = 7 THEN date_of_surgery END)                  AS surgery_7_date,
        MAX(CASE WHEN surgery_id = 8 THEN date_of_surgery END)                  AS surgery_8_date,
        MAX(CASE WHEN surgery_id = 9 THEN date_of_surgery END)                  AS surgery_9_date,
        MAX(CASE WHEN surgery_id = 10 THEN date_of_surgery END)                 AS surgery_10_date

    FROM surgeries_enriched
    GROUP BY person_id
    ),


    -- OBSERVATION table
    person_status AS (

        SELECT 
            person_id,
            status,
            {{ cohort_safe_date('observation_date') }} AS date
        FROM (
            SELECT 
                pid.person_id,
                observation_concept.concept_name as status,
                observation.observation_date,
                ROW_NUMBER() OVER (
                    PARTITION BY pid.person_id
                    ORDER BY observation.observation_date DESC
                ) AS observation_position
            FROM
                patient_id_list pid
            LEFT JOIN
                {{ cdm_schema }}.observation observation
                ON pid.person_id = observation.person_id
            LEFT JOIN
                {{ cdm_schema }}.concept observation_concept
                ON observation.observation_concept_id = observation_concept.concept_id
            WHERE
                observation.observation_concept_id IN ( 	
                    2000100071,     -- Alive, No Evidence of Disease (NED) 
                    4230556,        -- Alive 
                    2000100072,     -- Dead of Disease (DOD) 
                    2000100073,     -- Dead of Other Cause (DOC) 
                    2000100074,     -- Dead of Unknown Cause (DUC) 
                    2000100075,     -- Alive With Disease (AWD) 
                    4163894         -- Lost to follow-up 
                )
                AND observation.observation_date >= {{ COHORT_DATE_MIN }}
                AND observation.observation_date < {{ COHORT_DATE_MAX }}
        ) AS all_observations
        WHERE all_observations.observation_position = 1 -- get last observation
    ),

    -- MEASUREMENT table
    clinical_staging_flags AS (
        SELECT 
            pid.person_id,
            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769249
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as is_transit_metastasis_with_clinical_confirmation,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769933
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as is_multifocal_tumor,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769269
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as regional_nodal_metastases,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35225724
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as soft_tissue,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769243
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as distant_lymph_node,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770283
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as lung,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769301
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as metastasis_at_bone,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770544
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as liver,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226258
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as pleura,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226253
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as peritoneum,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36768862
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as brain,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769180
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as other_viscera,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 4129922
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as unknown
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
            AND measurement.measurement_concept_id IN (
                -- Clinical staging
                36769249, -- Is transit metastasis with clinical confirmation
                36769933, -- Is multifocal tumor
                36769269, -- Regional nodal metastases
                35225724, -- Soft tissue
                36769243, -- Distant lymph node
                36770283, -- Lung
                36769301, -- Metastasis at bone
                36770544, -- Liver
                35226258, -- Pleura
                35226253, -- Peritoneum
                36768862, -- Brain
                36769180, -- Other viscera
                4129922 -- Unknown
            )
            AND measurement.measurement_date >= {{ COHORT_DATE_MIN }}
            AND measurement.measurement_date < {{ COHORT_DATE_MAX }}
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        GROUP BY
            pid.person_id
    ),

    pathological_staging_flags AS (
        SELECT 
            pid.person_id,
            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769269
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as regional_nodal_metastases,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35225724
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as soft_tissue,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769243
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as distant_lymph_node,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770283
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as lung,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769301
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as metastasisatbone,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770544
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as liver,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226258
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as pleura,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226253
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as peritoneum,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36768862
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as brain,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769180
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as other_viscera,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 4129922
                            AND measurement.measurement_date = surgeries_wide.surgery_1_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as  unknown

        FROM 
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
            AND measurement.measurement_concept_id IN (
                -- Pathological staging
                36769269, -- Regional nodal metastases
                35225724, -- Soft tissue
                36769243, -- Distant lymph node
                36770283, -- Lung
                36769301, -- Metastasis at bone
                36770544, -- Liver
                35226258, -- Pleura
                35226253, -- Peritoneum
                36768862, -- Brain
                36769180, -- Other viscera
                4129922 -- Unknown
            )
            AND measurement.measurement_date >= {{ COHORT_DATE_MIN }}
            AND measurement.measurement_date < {{ COHORT_DATE_MAX }}
        LEFT JOIN
            surgeries_wide
            ON pid.person_id = surgeries_wide.person_id
        GROUP BY
            pid.person_id
    ),

    -- Radiotherapies
    radiotherapy_base AS (
        SELECT
            pid.person_id,
            episode.episode_id,
            {{ cohort_safe_date('episode.episode_start_date') }} AS radio_start_date,
            {{ cohort_safe_date('episode.episode_end_date') }} AS radio_end_date,
            CASE
                WHEN episode.episode_start_date > primary_tumor.diagnosis_date
                    AND episode.episode_start_date < surgeries_wide.surgery_1_date THEN 'pre-operative'
                WHEN episode.episode_start_date > surgeries_wide.surgery_1_date
                    AND episode.episode_start_date < COALESCE(progression_recurrence.first_progression_recurrence_date, DATE '2030-01-01') THEN 'post-operative'
                WHEN episode.episode_start_date > COALESCE(progression_recurrence.first_progression_recurrence_date, DATE '2030-01-01') THEN 'recurrence'
                ELSE 'other'
            END AS treatment_setting
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        LEFT JOIN
            surgeries_wide
            ON pid.person_id = surgeries_wide.person_id
        LEFT JOIN (
            SELECT 
                person_id,
                MIN(episode_start_date) AS first_progression_recurrence_date
            FROM {{ cdm_schema }}.episode 
            WHERE episode_concept_id IN (32948, 2000100002) -- Progression or recurrence episodes
              AND episode_start_date >= {{ COHORT_DATE_MIN }}
              AND episode_start_date < {{ COHORT_DATE_MAX }}
            GROUP BY person_id
        ) progression_recurrence
        ON pid.person_id = progression_recurrence.person_id
        WHERE episode.episode_concept_id = 32940 -- Radiotherapy episode
          AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
          AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
    ),
    
    radiotherapy_enriched AS (
        SELECT
            rtb.*,
            provider.provider_name AS radio_hospital,
            intent_concept.concept_name AS radio_intent,
            CASE
                WHEN rtb.treatment_setting = 'pre-operative' THEN 'pre-operative'
                WHEN rtb.treatment_setting = 'post-operative' THEN 'post-operative'
                WHEN rtb.treatment_setting = 'recurrence' THEN 'recurrence'
                ELSE 'other'
            END AS radio_setting,
            total_dose_measurement.value_as_number AS radio_total_dose_gy,
            number_of_fractions_measurement.value_as_number AS radio_number_of_fractions,
            treatment_completed_concept.concept_name AS radio_treatment_completed_as_planned,
            CASE
                WHEN rtb.radio_start_date IN (
                    SELECT procedure_date
                    FROM {{ cdm_schema }}.procedure_occurrence po
                    JOIN {{ cdm_schema }}.episode_event ee
                        ON po.procedure_occurrence_id = ee.event_id
                    JOIN {{ cdm_schema }}.episode episode
                        ON ee.episode_id = episode.episode_id
                    WHERE episode.episode_concept_id = 32940 -- Radiotherapy episode
                ) THEN 1
                ELSE 0
            END AS intraoperative_radio
        FROM
            radiotherapy_base rtb
        LEFT JOIN {{ cdm_schema }}.episode episode
            ON rtb.episode_id = episode.episode_id
        LEFT JOIN {{ cdm_schema }}.episode_event ee
            ON episode.episode_id = ee.episode_id
        LEFT JOIN {{ cdm_schema }}.procedure_occurrence po
            ON ee.event_id = po.procedure_occurrence_id
        LEFT JOIN {{ cdm_schema }}.provider provider
            ON po.provider_id = provider.provider_id
        LEFT JOIN {{ cdm_schema }}.measurement intent_measurement
            ON intent_measurement.measurement_event_id = po.procedure_occurrence_id
            AND intent_measurement.measurement_concept_id IN (4179711, 4162591) -- Radiotherapy intent concepts
        LEFT JOIN {{ cdm_schema }}.concept intent_concept
            ON intent_concept.concept_id = intent_measurement.measurement_concept_id
        LEFT JOIN {{ cdm_schema }}.measurement total_dose_measurement
            ON total_dose_measurement.measurement_event_id = po.procedure_occurrence_id
            AND total_dose_measurement.measurement_concept_id = 40483776 -- Total dose in Gy
        LEFT JOIN {{ cdm_schema }}.measurement number_of_fractions_measurement
            ON number_of_fractions_measurement.measurement_event_id = po.procedure_occurrence_id
            AND number_of_fractions_measurement.measurement_concept_id = 4037631 -- Number of fractions
        LEFT JOIN {{ cdm_schema }}.measurement treatment_completed_measurement
            ON treatment_completed_measurement.measurement_event_id = po.procedure_occurrence_id
            AND treatment_completed_measurement.measurement_concept_id IN (44788181, 4161588, 2000100030, 4105297, 37017062, 4306655) -- Treatment completed as planned concepts
        LEFT JOIN {{ cdm_schema }}.concept treatment_completed_concept
            ON treatment_completed_concept.concept_id = treatment_completed_measurement.measurement_concept_id
        ORDER BY rtb.person_id, rtb.radio_start_date ASC
    ),

{% if is_head_and_neck %}
    radiotherapy_enriched_with_more AS (
        SELECT
            rten.*,
            beam_quality_concept.concept_name AS radio_beam_quality,
            total_high_dose_measurement.value_as_number AS radio_total_high_dose,
            CASE
                WHEN po.modifier_concept_id IS NOT NULL THEN 1
                ELSE 0
            END AS radio_treatment_site_distant_metastasis
        FROM
            radiotherapy_enriched rten
        LEFT JOIN {{ cdm_schema }}.episode episode
            ON rten.episode_id = episode.episode_id
        LEFT JOIN {{ cdm_schema }}.episode_event ee
            ON episode.episode_id = ee.episode_id
        LEFT JOIN {{ cdm_schema }}.procedure_occurrence po
            ON ee.event_id = po.procedure_occurrence_id
            AND po.procedure_concept_id IN (607996,4165039,607995,4024005,4012485,4161415,4058601,4077953)
        LEFT JOIN {{ cdm_schema }}.concept beam_quality_concept
            ON beam_quality_concept.concept_id = po.procedure_concept_id
        LEFT JOIN {{ cdm_schema }}.measurement total_high_dose_measurement
            ON total_high_dose_measurement.measurement_event_id = po.procedure_occurrence_id
            AND total_high_dose_measurement.measurement_concept_id = 4129296 -- Total high dose in Gy
        ORDER BY rten.person_id, rten.radio_start_date ASC
    ),
{% else %}
    radiotherapy_enriched_with_more AS (
        SELECT
            rten.*,
            NULL AS radio_beam_quality,
            NULL AS radio_total_high_dose,
            NULL AS radio_treatment_site_distant_metastasis
        FROM
            radiotherapy_enriched rten
    ),
{% endif %}

    -- not sure if here we need to do something with the fact that "For H&N patients multiple procedures may be associated with the same radiotherapy episode"
    radiotherapy_ranked AS (
        SELECT
            rtem.*,
            ROW_NUMBER() OVER (
                PARTITION BY rtem.person_id
                ORDER BY rtem.radio_start_date
            ) AS radiotherapy_row_number
        FROM
            radiotherapy_enriched_with_more rtem
    ),

    radiotherapy_wide AS (
        SELECT
            person_id,

            -- Pre-operative radiotherapy
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_start_date END) AS pre_operative_radio_start_date,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_end_date END) AS pre_operative_radio_end_date,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_hospital END) AS pre_operative_radio_hospital,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_setting END) AS pre_operative_radio_setting,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_intent END) AS pre_operative_radio_intent,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_total_dose_gy END) AS pre_operative_radio_total_dose_gy,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_number_of_fractions END) AS pre_operative_radio_number_of_fractions,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_treatment_completed_as_planned END) AS pre_operative_radio_treatment_completed_as_planned,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN intraoperative_radio END) AS pre_operative_radio_intraoperative_radio,
            {% if is_head_and_neck %}
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_beam_quality END) AS pre_operative_radio_beam_quality,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_total_high_dose END) AS pre_operative_radio_total_high_dose,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN radio_treatment_site_distant_metastasis END) AS pre_operative_radio_treatment_site_distant_metastasis,
            {% endif %}

            -- Post-operative radiotherapy 1
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_start_date END) AS post_operative_radio_1_start_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_end_date END) AS post_operative_radio_1_end_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_hospital END) AS post_operative_radio_1_hospital,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_setting END) AS post_operative_radio_1_setting,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_intent END) AS post_operative_radio_1_intent,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_total_dose_gy END) AS post_operative_radio_1_total_dose_gy,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_number_of_fractions END) AS post_operative_radio_1_number_of_fractions,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_treatment_completed_as_planned END) AS post_operative_radio_1_treatment_completed_as_planned,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN intraoperative_radio END) AS post_operative_radio_1_intraoperative_radio,
            {% if is_head_and_neck %}
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_beam_quality END) AS post_operative_radio_1_beam_quality,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_total_high_dose END) AS post_operative_radio_1_total_high_dose,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 1 THEN radio_treatment_site_distant_metastasis END) AS post_operative_radio_1_treatment_site_distant_metastasis,
            {% endif %}

            -- Post-operative radiotherapy 2
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_start_date END) AS post_operative_radio_2_start_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_end_date END) AS post_operative_radio_2_end_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_hospital END) AS post_operative_radio_2_hospital,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_setting END) AS post_operative_radio_2_setting,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_intent END) AS post_operative_radio_2_intent,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_total_dose_gy END) AS post_operative_radio_2_total_dose_gy,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_number_of_fractions END) AS post_operative_radio_2_number_of_fractions,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_treatment_completed_as_planned END) AS post_operative_radio_2_treatment_completed_as_planned,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN intraoperative_radio END) AS post_operative_radio_2_intraoperative_radio,
            {% if is_head_and_neck %}
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_beam_quality END) AS post_operative_radio_2_beam_quality,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_total_high_dose END) AS post_operative_radio_2_total_high_dose,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND radiotherapy_row_number = 2 THEN radio_treatment_site_distant_metastasis END) AS post_operative_radio_2_treatment_site_distant_metastasis,
            {% endif %}

            -- Recurrence radiotherapy 1
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_start_date END) AS recurrence_radio_1_start_date,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_end_date END) AS recurrence_radio_1_end_date,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_hospital END) AS recurrence_radio_1_hospital,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_setting END) AS recurrence_radio_1_setting,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_intent END) AS recurrence_radio_1_intent,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_total_dose_gy END) AS recurrence_radio_1_total_dose_gy,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_number_of_fractions END) AS recurrence_radio_1_number_of_fractions,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_treatment_completed_as_planned END) AS recurrence_radio_1_treatment_completed_as_planned,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN intraoperative_radio END) AS recurrence_radio_1_intraoperative_radio,
            {% if is_head_and_neck %}
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_beam_quality END) AS recurrence_radio_1_beam_quality,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_total_high_dose END) AS recurrence_radio_1_total_high_dose,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 1 THEN radio_treatment_site_distant_metastasis END) AS recurrence_radio_1_treatment_site_distant_metastasis,
            {% endif %}            

            -- Recurrence radiotherapy 2
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_start_date END) AS recurrence_radio_2_start_date,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_end_date END) AS recurrence_radio_2_end_date,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_hospital END) AS recurrence_radio_2_hospital,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_setting END) AS recurrence_radio_2_setting,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_intent END) AS recurrence_radio_2_intent,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_total_dose_gy END) AS recurrence_radio_2_total_dose_gy,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_number_of_fractions END) AS recurrence_radio_2_number_of_fractions,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_treatment_completed_as_planned END) AS recurrence_radio_2_treatment_completed_as_planned,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN intraoperative_radio END) AS recurrence_radio_2_intraoperative_radio
            {% if is_head_and_neck %},
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_beam_quality END) AS recurrence_radio_2_beam_quality,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_total_high_dose END) AS recurrence_radio_2_total_high_dose,
            MAX(CASE WHEN treatment_setting = 'recurrence' AND radiotherapy_row_number = 2 THEN radio_treatment_site_distant_metastasis END) AS recurrence_radio_2_treatment_site_distant_metastasis
            {% endif %}

            -- List of radiotherapy start/end dates
            MAX(CASE WHEN radiotherapy_row_number = 1 THEN radio_start_date END)            AS radio_1_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 2 THEN radio_start_date END)            AS radio_2_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 3 THEN radio_start_date END)            AS radio_3_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 4 THEN radio_start_date END)            AS radio_4_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 5 THEN radio_start_date END)            AS radio_5_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 6 THEN radio_start_date END)            AS radio_6_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 7 THEN radio_start_date END)            AS radio_7_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 8 THEN radio_start_date END)            AS radio_8_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 9 THEN radio_start_date END)            AS radio_9_start_date,
            MAX(CASE WHEN radiotherapy_row_number = 10 THEN radio_start_date END)           AS radio_10_start_date,
            
            MAX(CASE WHEN radiotherapy_row_number = 1 THEN radio_end_date END)            AS radio_1_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 2 THEN radio_end_date END)            AS radio_2_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 3 THEN radio_end_date END)            AS radio_3_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 4 THEN radio_end_date END)            AS radio_4_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 5 THEN radio_end_date END)            AS radio_5_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 6 THEN radio_end_date END)            AS radio_6_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 7 THEN radio_end_date END)            AS radio_7_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 8 THEN radio_end_date END)            AS radio_8_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 9 THEN radio_end_date END)            AS radio_9_end_date,
            MAX(CASE WHEN radiotherapy_row_number = 10 THEN radio_end_date END)           AS radio_10_end_date

        FROM
            radiotherapy_ranked
        GROUP BY
            person_id
    ),


    -- Systemic therapies
    systemic_therapy_base AS (
        SELECT
            pid.person_id,
            episode.episode_id,
            {{ cohort_safe_date('episode.episode_start_date') }} AS systemic_treatment_start_date,
            {{ cohort_safe_date('episode.episode_end_date') }} AS systemic_treatment_end_date,
            regimen_concept.concept_id AS systemic_treatment_regimen_concept_id,
            regimen_concept.concept_name AS systemic_treatment_regimen,
            CASE
                WHEN episode.episode_start_date > primary_tumor.diagnosis_date
                    AND episode.episode_start_date < surgeries_wide.surgery_1_date THEN 'pre-operative'
                WHEN episode.episode_start_date > surgeries_wide.surgery_1_date
                    AND episode.episode_start_date < COALESCE(progression_recurrence.first_progression_recurrence_date, DATE '2030-01-01') THEN 'post-operative'
                WHEN episode.episode_start_date > COALESCE(progression_recurrence.first_progression_recurrence_date, DATE '2030-01-01') THEN 'recurrence'
                ELSE 'other'
            END AS treatment_setting
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            {{ cdm_schema }}.concept regimen_concept
            ON episode.episode_object_concept_id = regimen_concept.concept_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        LEFT JOIN
            surgeries_wide
            ON pid.person_id = surgeries_wide.person_id
        LEFT JOIN (
            SELECT 
                person_id,
                MIN(episode_start_date) AS first_progression_recurrence_date
            FROM {{ cdm_schema }}.episode 
            WHERE episode_concept_id IN (32948, 2000100002) -- Progression or recurrence episodes
              AND episode_start_date >= {{ COHORT_DATE_MIN }}
              AND episode_start_date < {{ COHORT_DATE_MAX }}
            GROUP BY person_id
        ) progression_recurrence
        ON pid.person_id = progression_recurrence.person_id
        WHERE episode.episode_concept_id = 32531 -- Systemic therapy episode
          AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
          AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
    ),

    systemic_therapy_enriched AS (
        SELECT
            stb.*,
            CASE
                WHEN stb.treatment_setting = 'pre-operative' THEN 'pre-operative'
                WHEN stb.treatment_setting = 'post-operative' THEN 'post-operative'
                WHEN stb.treatment_setting = 'recurrence' THEN 'recurrence'
                ELSE 'other'
            END AS systemic_setting,
            procedure_concept.concept_name AS systemic_treatment_type,
            procedure_concept.concept_id AS systemic_treatment_type_concept_id,
            reason_concept.concept_name AS systemic_treatment_reason_for_end_of_treatment
        FROM
            systemic_therapy_base stb
        LEFT JOIN {{ cdm_schema }}.episode episode
            ON stb.episode_id = episode.episode_id
        LEFT JOIN {{ cdm_schema }}.episode_event ee
            ON episode.episode_id = ee.episode_id
        LEFT JOIN {{ cdm_schema }}.procedure_occurrence po
            ON ee.event_id = po.procedure_occurrence_id
        LEFT JOIN {{ cdm_schema }}.concept procedure_concept
            ON po.procedure_concept_id = procedure_concept.concept_id
        LEFT JOIN {{ cdm_schema }}.observation observation
            ON observation.observation_event_id = po.procedure_occurrence_id
        LEFT JOIN {{ cdm_schema }}.concept reason_concept
            ON observation.observation_concept_id = reason_concept.concept_id
            AND observation.observation_concept_id IN (44788181, 4162594, 2000100030, 4240582, 37017062, 4306655)
        ORDER BY stb.person_id, stb.systemic_treatment_start_date ASC
    ),

{% if is_head_and_neck %}
    systemic_therapy_enriched_with_intent AS (
        SELECT
            ste.*,
            c.concept_name AS systemic_treatment_intent
        FROM
            systemic_therapy_enriched ste
        LEFT JOIN {{ cdm_schema }}.episode episode
            ON ste.episode_id = episode.episode_id
        LEFT JOIN {{ cdm_schema }}.episode_event ee
            ON episode.episode_id = ee.episode_id
        LEFT JOIN {{ cdm_schema }}.procedure_occurrence po
            ON ee.event_id = po.procedure_occurrence_id
        LEFT JOIN {{ cdm_schema }}.measurement m
            ON m.measurement_event_id = po.procedure_occurrence_id
            AND m.measurement_concept_id IN (4179711, 4162591) -- Surgery intent concepts
        LEFT JOIN {{ cdm_schema }}.concept c
            ON c.concept_id = m.measurement_concept_id
        ORDER BY ste.person_id, ste.systemic_treatment_start_date ASC
    ),
{% else %}
    systemic_therapy_enriched_with_intent AS (
        SELECT
            ste.*,
            NULL AS systemic_treatment_intent
        FROM
            systemic_therapy_enriched ste
    ),
{% endif %}

    systemic_therapy_ranked AS (
        SELECT
            stewi.*,
            ROW_NUMBER() OVER (
                PARTITION BY stewi.person_id
                ORDER BY stewi.systemic_treatment_start_date
            ) AS systemic_treatment_row_number
        FROM
            systemic_therapy_enriched_with_intent stewi
    ),

    systemic_therapy_wide AS (
        SELECT
            person_id,

            -- Pre-operative systemic therapy
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_start_date END) AS pre_operative_systemic_treatment_start_date,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_end_date END) AS pre_operative_systemic_treatment_end_date,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_regimen END) AS pre_operative_systemic_treatment_regimen,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_setting END) AS pre_operative_systemic_treatment_setting,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_type END) AS pre_operative_systemic_treatment_type,
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_reason_for_end_of_treatment END) AS pre_operative_systemic_treatment_reason_for_end_of_treatment,
            {% if is_head_and_neck %}
            MAX(CASE WHEN treatment_setting = 'pre-operative' THEN systemic_treatment_intent END) AS pre_operative_systemic_treatment_intent,
            {% endif %}

            -- Post-operative systemic therapy 1
            MAX(CASE WHEN treatment_setting = 'post-operative' AND systemic_treatment_row_number = 1 THEN systemic_treatment_start_date END) AS post_operative_systemic_treatment_1_start_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND systemic_treatment_row_number = 1 THEN systemic_treatment_end_date END) AS post_operative_systemic_treatment_1_end_date,
            MAX(CASE WHEN treatment_setting = 'post-operative' AND systemic_treatment_row_number = 1 THEN systemic_treatment_regimen END) AS post_operative_systemic_treatment_1_regimen,
