    radiotherapy_wide.radio_1_end_date                                                          as radio_1_end_date,
    radiotherapy_wide.radio_2_end_date                                                          as radio_2_end_date,
    radiotherapy_wide.radio_3_end_date                                                          as radio_3_end_date,
    radiotherapy_wide.radio_4_end_date                                                          as radio_4_end_date,
    radiotherapy_wide.radio_5_end_date                                                          as radio_5_end_date,
    radiotherapy_wide.radio_6_end_date                                                          as radio_6_end_date,
    radiotherapy_wide.radio_7_end_date                                                          as radio_7_end_date,
    radiotherapy_wide.radio_8_end_date                                                          as radio_8_end_date,
    radiotherapy_wide.radio_9_end_date                                                          as radio_9_end_date,
    radiotherapy_wide.radio_10_end_date                                                         as radio_10_end_date

{% if is_head_and_neck %},
    COALESCE(pathological_staging.stage, 'N/A')                                         as pathological_stage,
    COALESCE(pathological_staging_pt.stage, 'N/A')                                      as pathological_stage_pt,
    COALESCE(pathological_staging_pn.stage, 'N/A')                                      as pathological_stage_pn,
    COALESCE(pathological_staging_pm.stage, 'N/A')                                      as pathological_stage_pm,
    COALESCE(pathological_staging_ene.pathological_stage_extra_nodal_extension, 'N/A')  as pathological_stage_extra_nodal_extension,
    COALESCE(clinical_staging.stage, 'N/A')                                             as clinical_stage,
    COALESCE(clinical_staging_ct.stage, 'N/A')                                          as clinical_stage_ct,
    COALESCE(clinical_staging_cn.stage, 'N/A')                                          as clinical_stage_cn,
    COALESCE(clinical_staging_cm.stage, 'N/A')                                          as clinical_stage_cm,
    COALESCE(clinical_staging_ene.clinical_stage_extra_nodal_extension, 'N/A')          as clinical_stage_extra_nodal_extension,

    COALESCE(surgeries_wide.surgery_1_extra_nodal_extension, 'N/A') as surgery_1_extra_nodal_extension,
    COALESCE(surgeries_wide.surgery_2_extra_nodal_extension, 'N/A') as surgery_2_extra_nodal_extension,
    COALESCE(surgeries_wide.surgery_3_extra_nodal_extension, 'N/A') as surgery_3_extra_nodal_extension,
    COALESCE(surgeries_wide.surgery_4_extra_nodal_extension, 'N/A') as surgery_4_extra_nodal_extension,
    COALESCE(surgeries_wide.surgery_5_extra_nodal_extension, 'N/A') as surgery_5_extra_nodal_extension,

    COALESCE(surgeries_wide.surgery_1_laterality_of_the_dissection, 'N/A') as surgery_1_laterality_of_the_dissection,
    COALESCE(surgeries_wide.surgery_2_laterality_of_the_dissection, 'N/A') as surgery_2_laterality_of_the_dissection,
    COALESCE(surgeries_wide.surgery_3_laterality_of_the_dissection, 'N/A') as surgery_3_laterality_of_the_dissection,
    COALESCE(surgeries_wide.surgery_4_laterality_of_the_dissection, 'N/A') as surgery_4_laterality_of_the_dissection,
    COALESCE(surgeries_wide.surgery_5_laterality_of_the_dissection, 'N/A') as surgery_5_laterality_of_the_dissection,

    surgeries_wide.surgery_1_neck_surgery as surgery_1_neck_surgery,
    surgeries_wide.surgery_2_neck_surgery as surgery_2_neck_surgery,
    surgeries_wide.surgery_3_neck_surgery as surgery_3_neck_surgery,
    surgeries_wide.surgery_4_neck_surgery as surgery_4_neck_surgery,
    surgeries_wide.surgery_5_neck_surgery as surgery_5_neck_surgery,

    surgeries_wide.surgery_1_date_of_neck_surgery as surgery_1_date_of_neck_surgery,
    surgeries_wide.surgery_2_date_of_neck_surgery as surgery_2_date_of_neck_surgery,
    surgeries_wide.surgery_3_date_of_neck_surgery as surgery_3_date_of_neck_surgery,
    surgeries_wide.surgery_4_date_of_neck_surgery as surgery_4_date_of_neck_surgery,
    surgeries_wide.surgery_5_date_of_neck_surgery as surgery_5_date_of_neck_surgery,

    COALESCE(surgeries_wide.surgery_1_surgery_hospital, 'N/A') as surgery_1_surgery_hospital,
    COALESCE(surgeries_wide.surgery_2_surgery_hospital, 'N/A') as surgery_2_surgery_hospital,
    COALESCE(surgeries_wide.surgery_3_surgery_hospital, 'N/A') as surgery_3_surgery_hospital,
    COALESCE(surgeries_wide.surgery_4_surgery_hospital, 'N/A') as surgery_4_surgery_hospital,
    COALESCE(surgeries_wide.surgery_5_surgery_hospital, 'N/A') as surgery_5_surgery_hospital,

    COALESCE(systemic_therapy_wide.pre_operative_systemic_treatment_intent, 'N/A')      as pre_operative_systemic_treatment_intent,
    COALESCE(systemic_therapy_wide.post_operative_systemic_treatment_1_intent, 'N/A')   as post_operative_systemic_treatment_1_intent,
    COALESCE(systemic_therapy_wide.post_operative_systemic_treatment_2_intent, 'N/A')   as post_operative_systemic_treatment_2_intent,
    COALESCE(systemic_therapy_wide.recurrence_systemic_treatment_1_intent, 'N/A')       as recurrence_systemic_treatment_1_intent,
    COALESCE(systemic_therapy_wide.recurrence_systemic_treatment_2_intent, 'N/A')       as recurrence_systemic_treatment_2_intent,

    COALESCE(radiotherapy_wide.pre_operative_radio_beam_quality, 'N/A')                 as pre_operative_radio_beam_quality,
    radiotherapy_wide.pre_operative_radio_total_high_dose                               as pre_operative_radio_total_high_dose,
    radiotherapy_wide.pre_operative_radio_treatment_site_distant_metastasis             as pre_operative_radio_treatment_site_distant_metastasis,

    COALESCE(radiotherapy_wide.post_operative_radio_1_beam_quality, 'N/A')              as post_operative_radio_1_beam_quality,
    radiotherapy_wide.post_operative_radio_1_total_high_dose                            as post_operative_radio_1_total_high_dose,
    radiotherapy_wide.post_operative_radio_1_treatment_site_distant_metastasis          as post_operative_radio_1_treatment_site_distant_metastasis,

    COALESCE(radiotherapy_wide.post_operative_radio_2_beam_quality, 'N/A')              as post_operative_radio_2_beam_quality,
    radiotherapy_wide.post_operative_radio_2_total_high_dose                            as post_operative_radio_2_total_high_dose,
    radiotherapy_wide.post_operative_radio_2_treatment_site_distant_metastasis          as post_operative_radio_2_treatment_site_distant_metastasis,

    COALESCE(radiotherapy_wide.recurrence_radio_1_beam_quality, 'N/A')                  as recurrence_radio_1_beam_quality,
    radiotherapy_wide.recurrence_radio_1_total_high_dose                                as recurrence_radio_1_total_high_dose,
    radiotherapy_wide.recurrence_radio_1_treatment_site_distant_metastasis              as recurrence_radio_1_treatment_site_distant_metastasis,

    COALESCE(radiotherapy_wide.recurrence_radio_2_beam_quality, 'N/A')                  as recurrence_radio_2_beam_quality,
    radiotherapy_wide.recurrence_radio_2_total_high_dose                                as recurrence_radio_2_total_high_dose,
    radiotherapy_wide.recurrence_radio_2_treatment_site_distant_metastasis              as recurrence_radio_2_treatment_site_distant_metastasis

{% endif %}

{% if is_sarcoma %},
    COALESCE(biopsy.type_of_biopsy, 'N/A')                                                          as type_of_biopsy,
    biopsy.date_of_biopsy                                                                           as date_of_biopsy,
    clinical_staging_sarcoma.clinical_localised                                                     as clinical_localised,
    clinical_number_of_tumor_nodules.number_of_tumor_nodules                                        as clinical_number_of_tumor_nodules,
    clinical_staging_sarcoma.clinical_loco_regional                                                 as clinical_loco_regional,
    pathological_staging_sarcoma.pathological_localised                                             as pathological_localised,
    pathological_staging_sarcoma.pathological_loco_regional                                         as pathological_loco_regional,
    pathological_features_sarcoma.pathological_number_of_tumor_nodules                              as pathological_number_of_tumor_nodules,
    pathological_features_sarcoma.pathological_is_transit_metastasis_with_clinical_confirmation     as pathological_is_transit_metastasis_with_clinical_confirmation,
    pathological_features_sarcoma.pathological_is_multifocal_tumor                                  as pathological_is_multifocal_tumor,
    last_contact.last_contact                                                                       as last_contact
{% endif %}

FROM
    person
LEFT JOIN
    primary_tumor
    ON person.person_id = primary_tumor.person_id
LEFT JOIN
    person_status
    ON person.person_id = person_status.person_id
LEFT JOIN
    clinical_staging_flags
    ON person.person_id = clinical_staging_flags.person_id
LEFT JOIN
    pathological_staging_flags
    ON person.person_id = pathological_staging_flags.person_id
LEFT JOIN
    surgeries_wide
    ON person.person_id = surgeries_wide.person_id
LEFT JOIN
    systemic_therapy_wide
    ON person.person_id = systemic_therapy_wide.person_id
LEFT JOIN
    radiotherapy_wide
    ON person.person_id = radiotherapy_wide.person_id

{% if is_head_and_neck %}
LEFT JOIN
    pathological_staging
    ON person.person_id = pathological_staging.person_id
LEFT JOIN
    pathological_staging_pt
    ON person.person_id = pathological_staging_pt.person_id
LEFT JOIN
    pathological_staging_pn
    ON person.person_id = pathological_staging_pn.person_id
LEFT JOIN
    pathological_staging_pm
    ON person.person_id = pathological_staging_pm.person_id
LEFT JOIN
    pathological_staging_ene
    ON person.person_id = pathological_staging_ene.person_id
LEFT JOIN
    clinical_staging
    ON person.person_id = clinical_staging.person_id
LEFT JOIN
    clinical_staging_ct
    ON person.person_id = clinical_staging_ct.person_id
LEFT JOIN
    clinical_staging_cn
    ON person.person_id = clinical_staging_cn.person_id
LEFT JOIN
    clinical_staging_cm
    ON person.person_id = clinical_staging_cm.person_id
LEFT JOIN
    clinical_staging_ene
    ON person.person_id = clinical_staging_ene.person_id
{% endif %}

{% if is_sarcoma %}
LEFT JOIN
    biopsy
    ON person.person_id = biopsy.person_id
LEFT JOIN
    clinical_staging_sarcoma
    ON person.person_id = clinical_staging_sarcoma.person_id
LEFT JOIN
    clinical_number_of_tumor_nodules
    ON person.person_id = clinical_number_of_tumor_nodules.person_id
LEFT JOIN
    pathological_staging_sarcoma
    ON person.person_id = pathological_staging_sarcoma.person_id
LEFT JOIN
    pathological_features_sarcoma
    ON person.person_id = pathological_features_sarcoma.person_id
LEFT JOIN
    last_contact
    ON person.person_id = last_contact.person_id
{% endif %}