{% if is_sarcoma %},
----------------------------------------------------------------------------------------
-- SARCOMA FEATURES
--
-- Only sarcoma has the following features.
--
-- Type of biopsy
-- Date of biopsy
-- Clinical localised
-- Clinical loco-regional
-- Number of tumor nodules
--
----------------------------------------------------------------------------------------
    -- PROCEDURE OCCURRENCE table
    biopsy AS (
        SELECT
            all_biopsies.person_id,
            all_biopsies.concept_name as type_of_biopsy,
            {{ cohort_safe_date('all_biopsies.procedure_date') }} AS date_of_biopsy
        FROM (
            SELECT
                pid.person_id,
                procedure_concept.concept_name,
                procedure_occurrence.procedure_date,
                ROW_NUMBER() OVER (
                    PARTITION BY pid.person_id
                    ORDER BY procedure_occurrence.procedure_date ASC
                ) AS biopsy_position
            FROM
                patient_id_list pid
            LEFT JOIN
                {{ cdm_schema }}.procedure_occurrence procedure_occurrence
                ON pid.person_id = procedure_occurrence.person_id
            LEFT JOIN
                {{ cdm_schema }}.concept procedure_concept
                ON procedure_occurrence.procedure_concept_id = procedure_concept.concept_id
            WHERE 
                procedure_occurrence.procedure_concept_id IN (
                    4171863, 4321878,4321986, 4228202, 4279903, 4311405
                )
                AND procedure_occurrence.procedure_date >= {{ COHORT_DATE_MIN }}
                AND procedure_occurrence.procedure_date < {{ COHORT_DATE_MAX }}
        ) AS all_biopsies
        WHERE all_biopsies.biopsy_position = 1 -- get first biopsy
    ),

    -- EPISODE table
    clinical_staging_sarcoma AS (
        SELECT
            pid.person_id,
            MAX(
                CASE WHEN episode.episode_concept_id = 32942 
                AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
                AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
                AND episode.episode_start_date = primary_tumor.diagnosis_date 
                THEN 1 ELSE 0 END) as clinical_localised,
            MAX(
                CASE WHEN episode.episode_concept_id = 32943 
                AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
                AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
                AND episode.episode_start_date = primary_tumor.diagnosis_date 
                THEN 1 ELSE 0 END) as clinical_loco_regional
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        GROUP BY
            pid.person_id
    ),

    pathological_staging_sarcoma AS (
        SELECT
            pid.person_id,
            MAX(
                CASE WHEN episode.episode_concept_id = 32942 
                AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
                AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
                AND episode.episode_start_date = surgeries_wide.surgery_1_date 
                THEN 1 ELSE 0 END) as pathological_localised,
            MAX(
                CASE WHEN episode.episode_concept_id = 32943 
                AND episode.episode_start_date >= {{ COHORT_DATE_MIN }}
                AND episode.episode_start_date < {{ COHORT_DATE_MAX }}
                AND episode.episode_start_date = surgeries_wide.surgery_1_date 
                THEN 1 ELSE 0 END) as pathological_loco_regional
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            surgeries_wide
            ON pid.person_id = surgeries_wide.person_id
        GROUP BY
            pid.person_id
    ),

    -- MEASUREMENT table
    clinical_number_of_tumor_nodules AS (
        SELECT
            pid.person_id,
            measurement.value_as_number as number_of_tumor_nodules
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        WHERE
            measurement.measurement_concept_id = 4228659
            AND measurement.measurement_date >= {{ COHORT_DATE_MIN }}
            AND measurement.measurement_date < {{ COHORT_DATE_MAX }}
            AND measurement.measurement_date = primary_tumor.diagnosis_date
    ),

    pathological_features_sarcoma AS (
        SELECT
            pid.person_id,
            MAX(
                CASE 
                WHEN measurement.measurement_concept_id = 4228659 
                AND measurement.measurement_date = surgeries_wide.surgery_1_date
                THEN measurement.value_as_number END
            ) as pathological_number_of_tumor_nodules,
            MAX(
                CASE 
                WHEN measurement.measurement_concept_id = 36769249 
                AND measurement.measurement_date = surgeries_wide.surgery_1_date
                THEN 1 ELSE 0 END
            ) as pathological_is_transit_metastasis_with_clinical_confirmation,
            MAX(
                CASE 
                WHEN measurement.measurement_concept_id = 36769933 
                AND measurement.measurement_date = surgeries_wide.surgery_1_date
                THEN 1 ELSE 0 END
            ) as pathological_is_multifocal_tumor
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
            AND measurement.measurement_date >= {{ COHORT_DATE_MIN }}
            AND measurement.measurement_date < {{ COHORT_DATE_MAX }}
        LEFT JOIN
            surgeries_wide
            ON pid.person_id = surgeries_wide.person_id
        GROUP BY
            pid.person_id
    ),


    -- EPISODE table
    last_contact AS (
        SELECT
            pid.person_id,
            {{ cohort_safe_date('episode.episode_end_date') }} AS last_contact
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        WHERE
            episode.episode_concept_id = 32533
    )

{% endif %}



