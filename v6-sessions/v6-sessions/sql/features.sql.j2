{% if is_sarcoma %},
----------------------------------------------------------------------------------------
-- SARCOMA FEATURES
--
-- Only sarcoma has the following features.
--
-- Type of biopsy
-- Date of biopsy
-- Clinical localised
-- Clinical loco-regional
-- Number of tumor nodules
--
----------------------------------------------------------------------------------------
    -- PROCEDURE OCCURRENCE table
    biopsy AS (
        SELECT
            all_biopsies.person_id,
            all_biopsies.concept_name as type_of_biopsy,
            CASE
                WHEN all_biopsies.procedure_date >= DATE '3000-01-01' THEN NULL
                ELSE all_biopsies.procedure_date
            END as date_of_biopsy
        FROM (
            SELECT
                pid.person_id,
                procedure_concept.concept_name,
                procedure_occurrence.procedure_date,
                ROW_NUMBER() OVER (
                    PARTITION BY pid.person_id
                    ORDER BY procedure_occurrence.procedure_date ASC
                ) AS biopsy_position
            FROM
                patient_id_list pid
            LEFT JOIN
                {{ cdm_schema }}.procedure_occurrence procedure_occurrence
                ON pid.person_id = procedure_occurrence.person_id
            LEFT JOIN
                {{ cdm_schema }}.concept procedure_concept
                ON procedure_occurrence.procedure_concept_id = procedure_concept.concept_id
            WHERE 
                procedure_occurrence.procedure_concept_id IN (
                    4171863, 4321878,4321986, 4228202, 4279903, 4311405
                )
        ) AS all_biopsies
        WHERE all_biopsies.biopsy_position = 1 -- get first biopsy
    ),

    -- EPISODE table
    clinical_staging_sarcoma AS (
        SELECT
            pid.person_id,
            MAX(
                CASE WHEN episode.episode_concept_id = 32942 
                AND episode.episode_start_date = primary_tumor.diagnosis_date 
                THEN 1 ELSE 0 END) as clinical_localised,
            MAX(
                CASE WHEN episode.episode_concept_id = 32943 
                AND episode.episode_start_date = primary_tumor.diagnosis_date 
                THEN 1 ELSE 0 END) as clinical_loco_regional
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        GROUP BY
            pid.person_id
    ),    

    -- MEASUREMENT table
    clinical_number_of_tumor_nodules AS (
        SELECT
            pid.person_id,
            measurement.value_as_number as number_of_tumor_nodules
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        WHERE
            measurement.measurement_concept_id = 4228659
            AND measurement.measurement_date = primary_tumor.diagnosis_date
    ),

    -- EPISODE table
    last_contact AS (
        SELECT
            pid.person_id,
            CASE
                WHEN episode.episode_end_date >= DATE '3000-01-01' THEN NULL
                ELSE episode.episode_end_date
            END as last_contact
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        WHERE
            episode.episode_concept_id = 32533
    )

{% endif %}



----------------------------------------------------------------------------------------
-- Construct final table
----------------------------------------------------------------------------------------
SELECT

    person.person_id                                as patient_id,
    COALESCE(person.sex, 'N/A')                     as sex,
    person.year_of_birth                            as year_of_birth,
    primary_tumor.diagnosis_date                    as diagnosis_date,
    primary_tumor.age_at_diagnosis                  as age_at_diagnosis,
    primary_surgery.date_of_surgery                 as date_of_surgery,
    COALESCE(primary_tumor.diagnosis_code, 'N/A')   as diagnosis_code,
    COALESCE(primary_tumor.morphology, 'N/A')       as morphology,
    COALESCE(primary_tumor.topography, 'N/A')       as topography,
    COALESCE(person_status.status, 'N/A')           as life_status,
    person_status.date                              as life_status_date,

    clinical_staging_flags.is_transit_metastasis_with_clinical_confirmation as clinical_is_transit_metastasis_with_clinical_confirmation,
    clinical_staging_flags.is_multifocal_tumor               as clinical_is_multifocal_tumor,
    clinical_staging_flags.regional_nodal_metastases         as clinical_regional_nodal_metastases,
    clinical_staging_flags.soft_tissue                       as clinical_soft_tissue,
    clinical_staging_flags.distant_lymph_node                as clinical_distant_lymph_node,
    clinical_staging_flags.lung                              as clinical_lung,
    clinical_staging_flags.metastasis_at_bone                as clinical_metastasis_at_bone,
    clinical_staging_flags.liver                             as clinical_liver,
    clinical_staging_flags.pleura                            as clinical_pleura,
    clinical_staging_flags.peritoneum                        as clinical_peritoneum,
    clinical_staging_flags.brain                             as clinical_brain,
    clinical_staging_flags.other_viscera                     as clinical_other_viscera,
    clinical_staging_flags.unknown                           as clinical_unknown,

    pathological_staging_flags.regional_nodal_metastases     as pathological_regional_nodal_metastases,
    pathological_staging_flags.soft_tissue                   as pathological_soft_tissue,
    pathological_staging_flags.distant_lymph_node            as pathological_distant_lymph_node,
    pathological_staging_flags.lung                          as pathological_lung,
    pathological_staging_flags.metastasisatbone              as pathological_metastasis_at_bone,
    pathological_staging_flags.liver                         as pathological_liver,
    pathological_staging_flags.pleura                        as pathological_pleura,
    pathological_staging_flags.peritoneum                    as pathological_peritoneum,
    pathological_staging_flags.brain                         as pathological_brain,
    pathological_staging_flags.other_viscera                 as pathological_other_viscera,
    pathological_staging_flags.unknown                       as pathological_unknown     

{% if is_head_and_neck %},
    COALESCE(pathological_staging.stage, 'N/A')     as pathological_stage,
    COALESCE(pathological_staging_pt.stage, 'N/A')  as pathological_stage_pt,
    COALESCE(pathological_staging_pn.stage, 'N/A')  as pathological_stage_pn,
    COALESCE(pathological_staging_pm.stage, 'N/A')  as pathological_stage_pm,
    COALESCE(clinical_staging.stage, 'N/A')         as clinical_stage,
    COALESCE(clinical_staging_ct.stage, 'N/A')      as clinical_stage_ct,
    COALESCE(clinical_staging_cn.stage, 'N/A')      as clinical_stage_cn,
    COALESCE(clinical_staging_cm.stage, 'N/A')      as clinical_stage_cm
{% endif %}

{% if is_sarcoma %},
    COALESCE(biopsy.type_of_biopsy, 'N/A')          as type_of_biopsy,
    biopsy.date_of_biopsy                           as date_of_biopsy,
    clinical_staging_sarcoma.clinical_localised     as clinical_localised,
    clinical_number_of_tumor_nodules.number_of_tumor_nodules as number_of_tumor_nodules,
    clinical_staging_sarcoma.clinical_loco_regional as clinical_loco_regional,
    last_contact.last_contact                       as last_contact
{% endif %}

FROM
    person
LEFT JOIN
    primary_tumor
    ON person.person_id = primary_tumor.person_id
LEFT JOIN
    primary_surgery
    ON person.person_id = primary_surgery.person_id
LEFT JOIN
    person_status
    ON person.person_id = person_status.person_id
LEFT JOIN
    clinical_staging_flags
    ON person.person_id = clinical_staging_flags.person_id
LEFT JOIN
    pathological_staging_flags
    ON person.person_id = pathological_staging_flags.person_id

{% if is_head_and_neck %}
LEFT JOIN
    pathological_staging
    ON person.person_id = pathological_staging.person_id
LEFT JOIN
    pathological_staging_pt
    ON person.person_id = pathological_staging_pt.person_id
LEFT JOIN
    pathological_staging_pn
    ON person.person_id = pathological_staging_pn.person_id
LEFT JOIN
    pathological_staging_pm
    ON person.person_id = pathological_staging_pm.person_id
LEFT JOIN
    clinical_staging
    ON person.person_id = clinical_staging.person_id
LEFT JOIN
    clinical_staging_ct
    ON person.person_id = clinical_staging_ct.person_id
LEFT JOIN
    clinical_staging_cn
    ON person.person_id = clinical_staging_cn.person_id
LEFT JOIN
    clinical_staging_cm
    ON person.person_id = clinical_staging_cm.person_id
{% endif %}

{% if is_sarcoma %}
LEFT JOIN
    biopsy
    ON person.person_id = biopsy.person_id
LEFT JOIN
    clinical_staging_sarcoma
    ON person.person_id = clinical_staging_sarcoma.person_id
LEFT JOIN
    clinical_number_of_tumor_nodules
    ON person.person_id = clinical_number_of_tumor_nodules.person_id
LEFT JOIN
    last_contact
    ON person.person_id = last_contact.person_id
{% endif %}
