----------------------------------------------------------------------------------------
-- Head and Neck features
-- This query is used to extract the features from the Head and Neck dataset.

-- VERSION  | AUTHOR         | DATE          | DESCRIPTION
-- -------------------------------------------------------------------------------------
-- 1.0      | F. Martin      | 2026-02-10    | Initial version
-- -------------------------------------------------------------------------------------
-- 1.1      | F. Martin      | 2026-02-11    | Update the clinical staging codes and 
--          | A. van Gestel  |               | fixed some minor issues.
-- -------------------------------------------------------------------------------------
-- 1.2      | F. Martin      | 2026-03-10    | Introduced flexible feature selection,
--          |                |               | using Jinja2 template.
-- -------------------------------------------------------------------------------------
--
----------------------------------------------------------------------------------------
-- BASIC FEATURES
--
-- Both head and neck and sarcoma have the same basic features.
--
-- Patient ID
-- The patient ID is the ID of the patient.
--
-- Sex
-- In `PERSON.gender_concept_id` there are two codes:
-- 1. Female: 8507
-- 2. Male: 8532
-- This results in a categorical variable with two levels: "Female" and "Male".
--
-- Year of Birth
-- In `PERSON.year_of_birth` there is the year of birth of the patient.
-- This results in a Integer variable with the year of birth.
--
-- Diagnosis date
-- of episode_concept_id of 32533 Disease Episode (always one) look up the date
--
-- Morphology
-- Extract episode_object_concept_id this contains the omop concept id for the ICDO3 
-- code (for topography and morphology).
--
-- Topography
-- Second part of `concept_code` of `episode.episode_object_concept_id` where `episode.episode_concept_id = 32533`
--
-- Life status
-- Concept_id look for codes of Alive Dead etc (see excel). Look for latest date. 
-- Translate from the vocabulary (also store the date)
--
-- Life status date
-- `observation.observation_date` of the latest observation where `observation.observation_concept_id` is one of `2000100071`, `4230556`, `2000100072`,`2000100073`, `2000100074`, `2000100075`, `4163894`.
----------------------------------------------------------------------------------------

WITH

    -- Define the list of patient IDs to analyze
    patient_id_list AS (
        SELECT person_id FROM (VALUES {{ patient_ids }}) AS t(person_id)
    ),

    -- PERSON table
    person AS (
        SELECT
            pid.person_id, -- e.g. 12345
            gender_concept.concept_name as sex, -- e.g. "Female" or "Male"
            person.year_of_birth -- e.g. 1990
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.person person 
            ON pid.person_id = person.person_id
        LEFT JOIN
            {{ cdm_schema }}.concept gender_concept 
            ON person.gender_concept_id = gender_concept.concept_id
    ),

    -- EPISODE table
    primary_tumor AS (
        SELECT
            pid.person_id,
            episode.episode_id                                                      as episode_id,
            CASE
                WHEN episode.episode_start_date >= DATE '3000-01-01' THEN NULL
                ELSE episode.episode_start_date
            END                                                                    as diagnosis_date, -- e.g. 2020-01-01
            CASE
                WHEN episode.episode_start_date >= DATE '3000-01-01' THEN NULL
                ELSE EXTRACT(YEAR FROM episode.episode_start_date) - person.year_of_birth
            END                                                                    as age_at_diagnosis, -- e.g. 67
            diagnosis_concept.concept_name                                          as diagnosis_code, -- e.g. "C34.1-8888/8"
            split_part(diagnosis_concept.concept_code, '-', 1)                      as morphology, -- e.g. 8888/8
            split_part(diagnosis_concept.concept_code, '-', 2)                      as topography -- e.g. C34.1
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            {{ cdm_schema }}.concept diagnosis_concept
            ON episode.episode_object_concept_id = diagnosis_concept.concept_id
        LEFT JOIN
            {{ cdm_schema }}.person person
            ON pid.person_id = person.person_id
        WHERE
            episode.episode_concept_id = 32533 -- Disease Episode
    ),

    primary_surgery AS (
        SELECT
            pid.person_id,
            CASE
                WHEN episode.episode_start_date >= DATE '3000-01-01' THEN NULL
                ELSE episode.episode_start_date
            END as date_of_surgery
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.episode episode
            ON pid.person_id = episode.person_id
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        WHERE
            episode.episode_concept_id = 32939 -- Surgery Episode
            AND episode.episode_parent_id IN (
                SELECT primary_tumor.episode_id FROM primary_tumor
            )
        ORDER BY
            episode.episode_start_date ASC
        LIMIT 1
    ),

    -- OBSERVATION table
    person_status AS (

        SELECT 
            person_id,
            status,
            CASE
                WHEN observation_date >= DATE '3000-01-01' THEN NULL
                ELSE observation_date
            END as date
        FROM (
            SELECT 
                pid.person_id,
                observation_concept.concept_name as status,
                observation.observation_date,
                ROW_NUMBER() OVER (
                    PARTITION BY pid.person_id
                    ORDER BY observation.observation_date DESC
                ) AS observation_position
            FROM
                patient_id_list pid
            LEFT JOIN
                {{ cdm_schema }}.observation observation
                ON pid.person_id = observation.person_id
            LEFT JOIN
                {{ cdm_schema }}.concept observation_concept
                ON observation.observation_concept_id = observation_concept.concept_id
            WHERE
                observation.observation_concept_id IN ( 	
                    2000100071,     -- Alive, No Evidence of Disease (NED) 
                    4230556,        -- Alive 
                    2000100072,     -- Dead of Disease (DOD) 
                    2000100073,     -- Dead of Other Cause (DOC) 
                    2000100074,     -- Dead of Unknown Cause (DUC) 
                    2000100075,     -- Alive With Disease (AWD) 
                    4163894         -- Lost to follow-up 
                )
        ) AS all_observations
        WHERE all_observations.observation_position = 1 -- get last observation
    ),

    -- MEASUREMENT table
    clinical_staging_flags AS (
        SELECT 
            pid.person_id,
            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769249
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as is_transit_metastasis_with_clinical_confirmation,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769933
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as is_multifocal_tumor,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769269
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as regional_nodal_metastases,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35225724
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as soft_tissue,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769243
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as distant_lymph_node,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770283
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as lung,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769301
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as metastasis_at_bone,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770544
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as liver,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226258
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as pleura,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226253
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as peritoneum,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36768862
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as brain,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769180
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as other_viscera,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 4129922
                            AND measurement.measurement_date = primary_tumor.diagnosis_date
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as unknown
        FROM
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
            AND measurement.measurement_concept_id IN (
                -- Clinical staging
                36769249, -- Is transit metastasis with clinical confirmation
                36769933, -- Is multifocal tumor
                36769269, -- Regional nodal metastases
                35225724, -- Soft tissue
                36769243, -- Distant lymph node
                36770283, -- Lung
                36769301, -- Metastasis at bone
                36770544, -- Liver
                35226258, -- Pleura
                35226253, -- Peritoneum
                36768862, -- Brain
                36769180, -- Other viscera
                4129922 -- Unknown
            )
        LEFT JOIN
            primary_tumor
            ON pid.person_id = primary_tumor.person_id
        GROUP BY
            pid.person_id
    ),

    pathological_staging_flags AS (
        SELECT 
            pid.person_id,
            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769269
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as regional_nodal_metastases,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35225724
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as soft_tissue,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769243
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as distant_lymph_node,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770283
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as lung,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769301
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as metastasisatbone,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36770544
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as liver,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226258
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as pleura,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 35226253
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as peritoneum,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36768862
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as brain,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 36769180
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as other_viscera,

            COALESCE(
                MAX(
                    CASE
                        WHEN measurement.measurement_concept_id = 4129922
                            AND measurement.measurement_date = primary_surgery.date_of_surgery
                        THEN 1 ELSE 0
                    END
                ),
                0
            ) as  unknown

        FROM 
            patient_id_list pid
        LEFT JOIN
            {{ cdm_schema }}.measurement measurement
            ON pid.person_id = measurement.person_id
            AND measurement.measurement_concept_id IN (
                -- Pathological staging
                36769269, -- Regional nodal metastases
                35225724, -- Soft tissue
                36769243, -- Distant lymph node
                36770283, -- Lung
                36769301, -- Metastasis at bone
                36770544, -- Liver
                35226258, -- Pleura
                35226253, -- Peritoneum
                36768862, -- Brain
                36769180, -- Other viscera
                4129922 -- Unknown
            )
        LEFT JOIN
            primary_surgery
            ON pid.person_id = primary_surgery.person_id
        GROUP BY
            pid.person_id
    )

